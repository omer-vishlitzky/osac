FROM registry.access.redhat.com/ubi10/go-toolset:1.26.7-1788213683 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /opt/app-root/src
COPY --chown=1001:0 schema/ schema/
COPY --chown=1001:0 metering-service/go.mod metering-service/go.sum metering-service/
RUN \
  set -eu; \
  for attempt in 1 2 3 4 5; do \
    if output=$(cd metering-service && go mod download 2>&1); then \
      printf '%s\n' "$output"; \
      exit 0; \
    else \
      status=$?; \
    fi; \
    printf '%s\n' "$output" >&2; \
    if ! printf '%s\n' "$output" | grep -Eq 'stream error|unexpected EOF|connection (reset|refused|closed)|i/o timeout|TLS handshake timeout|proxyconnect|no such host|HTTP (408|429|5[0-9][0-9])'; then \
      exit "$status"; \
    fi; \
    if [ "$attempt" -lt 5 ]; then sleep "$((attempt * 2))"; fi; \
  done; \
  exit 1

COPY --chown=1001:0 metering-service/ metering-service/

RUN cd metering-service && CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -buildvcs=false -a -o /opt/app-root/src/bin/metering-service ./cmd/metering-service

FROM registry.access.redhat.com/ubi10-minimal:10.2
WORKDIR /
COPY --from=builder /opt/app-root/src/bin/metering-service .
USER 65532:65532
ENTRYPOINT ["/metering-service"]
